# Copy this file to .env and fill in the values you need.
# Never commit .env — it contains your API keys.

# ── AI Provider (at least one is required) ──────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Options: gemini | groq
PRIMARY_ENGINE=gemini

# Optional fallback providers
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# OPENAI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434

# ── API Server ──────────────────────────────────────────────────
# Loopback only by default. Do NOT set 0.0.0.0: the API can run commands on this PC.
JARVIS_API_HOST=127.0.0.1
# Extra browser origins / Host headers allowed to call the API (comma-separated).
# JARVIS_ALLOWED_ORIGINS=
# JARVIS_ALLOWED_HOSTS=

# ── Security ────────────────────────────────────────────────────
# Optional. If unset, a per-install secret is generated in data/security/.jwt_secret
# JARVIS_JWT_SECRET=
JARVIS_TOKEN_EXPIRE_HOURS=12

# Load LLM-generated tools from tools/custom/ at startup (off by default)
# JARVIS_ENABLE_CUSTOM_TOOLS=1

# ── Voice ───────────────────────────────────────────────────────
JARVIS_TTS_RATE=175
JARVIS_MIC_TIMEOUT=8
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
