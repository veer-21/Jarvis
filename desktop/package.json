{
  "name": "jarvis-desktop",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "cross-env NODE_ENV=development electron .",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:127.0.0.1:3000 && npm run electron:start\"",
    "electron:prod": "vite build && electron .",
    "pack": "vite build && electron-builder --win --dir",
    "dist": "vite build && electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "framer-motion": "^10.16.4",
    "lucide-react": "^0.279.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.4.14",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^42.4.0",
    "electron-builder": "^26.18.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.2",
    "vite": "^4.4.5",
    "wait-on": "^7.0.1"
  },
  "productName": "JARVIS",
  "description": "JARVIS personal AI assistant",
  "author": "JARVIS",
  "build": {
    "appId": "com.jarvis.assistant",
    "productName": "JARVIS",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../packaging/dist/jarvis-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "JARVIS",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "veer-21",
        "repo": "Jarvis"
      }
    ]
  }
}
